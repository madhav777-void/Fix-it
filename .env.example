# APK Hardening Audit Tool - Configuration Example

# Flask Secret Key for session signing (leave unset to auto-generate)
# SECRET_KEY=your-secure-random-key-here

# Server host and port
HOST=127.0.0.1
PORT=5000

# Optional custom path to apktool executable or jar
# APKTOOL_CMD=apktool
# APKTOOL_JAR=/path/to/apktool.jar

# Maximum APK upload size in bytes (default: 200MB = 209715200)
# MAX_APK_SIZE_BYTES=209715200
