# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Local audit workspace (uploads and generated reports)
workspace/*
!workspace/.gitkeep
uploads/

# Binaries and downloaded dependencies
bin/*.jar
!bin/.gitkeep

# Environments & sensitive files
.env
.venv
env/
venv/
ENV/

# IDE / OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
