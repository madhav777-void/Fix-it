# Set default behavior to automatically normalize line endings
* text=auto

# Explicit text files with LF normalization for cross-platform compatibility
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf

# Batch and PowerShell scripts (keep Windows CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts (keep LF)
*.sh text eol=lf

# Binary files
*.apk binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
